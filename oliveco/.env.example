# Optional. Leave the key blank to use the local product guide.
# Keep keys in this server-only file. Never put a key in dist/.
AI_API_KEY=
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-nano
AI_MAX_OUTPUT_TOKENS=700
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=40
AI_GLOBAL_REQUESTS_PER_DAY=500
CHAT_REQUESTS_PER_MINUTE=20
CHAT_REQUESTS_PER_HOUR=120
# Optional random secret (32+ characters) for chat cookies across restarts.
# Leave blank to generate an in-memory secret automatically.
CHAT_SESSION_SECRET=
# Enable only behind the trusted Cloudflare tunnel and reverse proxy.
TRUST_PROXY=false
PORT=4173
HOST=127.0.0.1
# Set the public HTTPS origin when deploying behind a reverse proxy.
PUBLIC_ORIGIN=
